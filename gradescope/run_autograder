#!/usr/bin/env bash

# Runs the instructor's harness against one submission and writes the JSON
# Gradescope reads (issue #404).
#
# The harness and the student's files must sit in one directory: a Scamper
# program may only import files beside it, and the CLI roots its file system at
# the directory of the program it is given.
#
# The four directories below are Gradescope's; they are overridable only so that
# an instructor can rehearse a harness on their own machine:
#
#   SCAMPER_DIR=~/scamper SOURCE_DIR=. SUBMISSION_DIR=./student \
#     RESULTS_DIR=/tmp/results WORK_DIR=/tmp/work ./run_autograder

set -uo pipefail

SCAMPER_DIR="${SCAMPER_DIR:-/autograder/scamper}"
SOURCE_DIR="${SOURCE_DIR:-/autograder/source}"
SUBMISSION_DIR="${SUBMISSION_DIR:-/autograder/submission}"
RESULTS_DIR="${RESULTS_DIR:-/autograder/results}"
WORK_DIR="${WORK_DIR:-/autograder/work}"

# How long a submission gets. A student's own infinite loop is the usual reason
# this matters; without it the whole autograder run is killed with no results.
TIMEOUT="${SCAMPER_TIMEOUT:-120}"

RESULTS_FILE="${RESULTS_DIR}/results.json"

mkdir -p "${RESULTS_DIR}" "${WORK_DIR}"
cp "${SOURCE_DIR}/autograder.scm" "${WORK_DIR}/"
cp -r "${SUBMISSION_DIR}/." "${WORK_DIR}/"

# `npx tsx`, not `npm run cli`: npm prints its own banner to stdout, and stdout
# here is the results file. Errors go to stderr, which is kept for the fallback
# below.
timeout "${TIMEOUT}" npx --prefix "${SCAMPER_DIR}" tsx \
  "${SCAMPER_DIR}/src/app/cli/index.ts" "${WORK_DIR}/autograder.scm" \
  > "${WORK_DIR}/results.json" 2> "${WORK_DIR}/stderr.txt"
status=$?

# A submission that does not compile, imports the wrong file name, or loops
# forever produces no JSON at all. Report that as a zero with the error in it,
# rather than leaving Gradescope with an unreadable results file and the student
# with no idea why.
if [ "${status}" -ne 0 ] ||
   ! node -e 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' \
     "${WORK_DIR}/results.json" 2>/dev/null; then
  if [ "${status}" -eq 124 ]; then
    reason="Your submission took longer than ${TIMEOUT} seconds to run, so it was stopped. Check for an expression that never finishes."
  else
    reason="The autograder could not run your submission."
  fi
  node -e '
    const fs = require("fs")
    const [resultsFile, reason, errFile] = process.argv.slice(1)
    const err = fs.existsSync(errFile) ? fs.readFileSync(errFile, "utf8").trim() : ""
    fs.writeFileSync(resultsFile, JSON.stringify({
      score: 0,
      output: err === "" ? reason : `${reason}\n\n${err}`,
    }, null, 2) + "\n")
  ' "${RESULTS_FILE}" "${reason}" "${WORK_DIR}/stderr.txt"
  exit 0
fi

cp "${WORK_DIR}/results.json" "${RESULTS_FILE}"
