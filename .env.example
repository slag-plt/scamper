# Configuration for docker-compose.yml. Copy to `.env` beside it and fill in.
# `.env` is gitignored: it holds the session secret and the database password.

# --- Database -----------------------------------------------------------------
# Only the server reaches this database; the port is not published.
MARIADB_DATABASE=scamper
MARIADB_USER=scamper
#
# These go into a connection URL as-is, so keep them to letters and digits:
# an @, :, /, or # in a password produces a URL that parses as something else.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- Sessions -----------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it signs everyone out; publishing it lets anyone mint a session for
# any user, so it does not belong in the repository.
BETTER_AUTH_SECRET=

# The origin Scamper is served from, PORT INCLUDED. Sign-in is refused with
# "Invalid origin" if this does not match what the browser's address bar says,
# so it is the first thing to check when sign-in fails and nothing else does.
#
#   http://localhost:8080        the compose stack (matches WEB_PORT below)
#   http://localhost:5173        `npm run dev -- --mode server` against it
#   https://scamper.example.edu  a real deployment
BETTER_AUTH_URL=http://localhost:8080

# Other origins allowed to sign in, comma-separated. Leave empty in a real
# deployment. Useful locally so `npm run dev -- --mode server` (on :5173) can
# sign in to this same stack without editing the line above.
SCAMPER_TRUSTED_ORIGINS=http://localhost:5173

# --- Accounts -----------------------------------------------------------------
# There is no self-service sign-up and no mail server, so accounts are made by
# hand and the password handed over directly:
#
#   docker compose exec server node_modules/.bin/tsx server/src/admin.ts \
#     create ada@example.edu "Ada Lovelace"
#
# A forgotten password is `admin.ts reset <email>`, which also signs that person
# out everywhere. Nothing here to configure -- noted so it is not looked for.

# --- Host ---------------------------------------------------------------------
# Where the app is published. `web` (Caddy) serves the front end and proxies
# /api to the server, so this is the port students' browsers reach.
WEB_PORT=8080

# The API's own port, published on loopback only. Nothing external needs it --
# it is here so `npm run dev -- --mode server` can proxy to it, and so it can be
# curled while debugging.
SERVER_PORT=3000
