# Configuration for docker-compose.yml. Copy to `.env` beside it and fill in.
# `.env` is gitignored: it holds the session secret and the database password.

# --- Database -----------------------------------------------------------------
# Only the server reaches this database; the port is not published.
MARIADB_DATABASE=scamper
MARIADB_USER=scamper
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- Sessions -----------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it signs everyone out; publishing it lets anyone mint a session for
# any user, so it does not belong in the repository.
BETTER_AUTH_SECRET=

# The origin Scamper is served from -- the same host that serves the static
# files, since the two share an origin. e.g. https://scamper.cs.grinnell.edu
BETTER_AUTH_URL=

# --- Microsoft (Entra ID) sign-in ----------------------------------------------
# Optional: leave all three blank and only email/password sign-in is offered.
# From an app registration with the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/microsoft
#
# The tenant is your institution's directory, and is what limits sign-in to
# people in it. There is deliberately no `common` default, which would accept
# any Microsoft account anywhere.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# --- Host ---------------------------------------------------------------------
# Which loopback port the container is published on, for the web server in
# front of it to proxy to.
SERVER_PORT=3000
