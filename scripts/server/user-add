#!/usr/bin/env bash

# Makes an account and prints its password.
#
# There is no sign-up (server/src/auth.ts explains why), so this is the only way
# anyone gets in. The password is shown once and cannot be read back -- pass it
# on before closing the terminal.
#
#   scripts/server/user-add ada@example.edu "Ada Lovelace" [password]

source "$(dirname "$0")/lib.sh"

[ $# -ge 2 ] || usage "$0 <email> <name> [password]"

admin create "$@"
