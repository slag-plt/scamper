// The test tree's own project. Until #509 nothing ran it: it existed only for
// ESLint's `projectService`, and type-aware lint rules do not report the
// compile errors -- a fixture missing a member, a call site left behind by a
// changed signature -- that had accumulated here unseen. `npm run
// typecheck:test` runs it now and `scripts/validate-build` gates on it, so it
// is a blocking step.
//
// It relaxes no check the root config makes: a spec runs under exactly the
// strictness `src/` does. What it adds below is about what is *in* the project
// -- a .mjs script, ambient test types -- not about how hard it is checked. In
// particular `noUncheckedIndexedAccess` stays off, for the reason recorded at
// length in the root config -- measured against this project too, it costs
// several hundred errors across bounded loops and fixture indexing and buys
// nothing.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Three specs import a .mjs at the repository root directly: the freshness
    // one reads scripts/generate-lib-sources.mjs, to compare what it would
    // write against what is checked in; the DOM-instanceof lint one reads
    // eslint.config.mjs, so it pins the selector the build runs rather than a
    // copy; and the embed-bundle-name one reads scripts/embed-bundle-name.mjs,
    // which is where that filename is decided. Without allowJs those imports
    // resolve to nothing and read as untyped.
    "allowJs": true,
    "types": ["@testing-library/jest-dom/vitest", "node"]
  },
  "include": [
    "./**/*",
    "./setup.ts",
    "../src/env.d.ts",
    "../src/js/image/colorsys.d.ts",
    "../scripts/embed-bundle-name.mjs",
    "../scripts/generate-lib-sources.mjs",
    "../eslint.config.mjs"
  ],
  // empty exclude needed to override base tsconfig
  "exclude": []
}
