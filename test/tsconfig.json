// The test tree's own project. Until #509 nothing ran it: it existed only for
// ESLint's `projectService`, and type-aware lint rules do not report the
// compile errors -- a fixture missing a member, a call site left behind by a
// changed signature -- that had accumulated here unseen. `npm run
// typecheck:test` runs it now and `scripts/validate-build` gates on it, so it
// is a blocking step.
//
// It adds no compiler option to the root config and relaxes none of them: a
// spec runs under exactly the strictness `src/` does. In particular
// `noUncheckedIndexedAccess` stays off, for the reason recorded at length in
// the root config -- measured against this project too, it costs several
// hundred errors across bounded loops and fixture indexing and buys nothing.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The freshness spec imports scripts/generate-lib-sources.mjs directly, to
    // compare what it would write against what is checked in. Without allowJs
    // that import resolves to nothing and the call reads as untyped.
    "allowJs": true,
    "types": ["@testing-library/jest-dom/vitest", "node"]
  },
  "include": [
    "./**/*",
    "./setup.ts",
    "../src/env.d.ts",
    "../src/js/image/colorsys.d.ts",
    "../scripts/generate-lib-sources.mjs"
  ],
  // empty exclude needed to override base tsconfig
  "exclude": []
}
