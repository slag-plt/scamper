@top Program { statement* }

@skip { space | LineComment }

// N.B., each of the three bracket kinds means exactly one thing: "(...)" is a
// list/application/special form, "[...]" is a vector (or, in a pattern, a vector
// pattern) or one of the fixed [pattern expression] pair positions, and "{...}"
// is a map literal. "{" used to be interchangeable with "(", but that spelling
// was given up so the map literal could have it (issue #334).
paren<content> { "(" content ")" }

simplearglist {
  paren<Identifier*>
}

arglist {
  simplearglist |
  paren<Identifier* Amp Identifier>
}

binding {
  "[" pattern expression "]"
}

branch {
  "[" pattern expression "]"
}

condBranch {
  "[" expression expression "]"
}

pattern {
  Number |
  Identifier |
  String |
  Boolean |
  Char |
  PApp { paren<pattern*> } |
  PVector { "[" pattern* "]" }
}

expression {
  Number |
  Identifier |
  String |
  Boolean |
  Char |
  Vector { "[" expression* "]" } |
  // A Clojure-style map literal: an even number of expressions read as
  // alternating keys and values, e.g. {"name" "Alice" "age" 30}. Every element
  // is an ordinary sub-expression (the even-length check lives in
  // lezer-bridge.ts, which the grammar cannot express).
  Obj { "{" expression* "}" } |
  Lambda { paren<kw<"lambda"> arglist expression> } |
  If { paren<kw<"if"> expression expression expression> } |
  And { paren<kw<"and"> expression*> } |
  Or { paren<kw<"or"> expression*> } |
  Begin { paren<kw<"begin"> expression expression*> } |
  Cond { paren<kw<"cond"> condBranch*> } |
  // A Clojure-style anonymous function: the "#" marker followed by an ordinary
  // parenthesized expression, e.g. #(+ %1 1) or #(let ([x 1]) (+ x %)). Because
  // the body is a normal expression, any parenthesized form (application, let,
  // if, ...) can appear -- expansion wraps it verbatim in a lambda.
  AnonFn { AnonHash expression } |
  Application { paren<expression*> } |
  Let { paren<kw<"let"> paren<binding*> expression> } |
  Match { paren<kw<"match"> expression branch*> }
}

statement {
  // The optional trailing Identifier is the module's qualified name (alias) in
  // the importing file, e.g. (import image img) -- see lezer-bridge.ts. It must
  // be a simple (unqualified) name; that is enforced there, not in the grammar.
  Import { paren<kw<"import"> (Identifier | String) Identifier?> } |
  Define { paren<kw<"define"> Identifier expression> } |
  // Explicit module exports: (export a b c) lists names to export; a module
  // exports only what its export statements name (see scope.ts / the fiber).
  Export { paren<kw<"export"> Identifier*> } |
  // (define-export x e) is sugar for (define x e) (export x); see expansion.ts.
  DefineExport { paren<kw<"define-export"> Identifier expression> } |
  Display { paren<kw<"display"> expression> } |
  Struct { paren<kw<"struct"> Identifier simplearglist> } |
  SExpr { expression }
}

kw<term> { @specialize[@name={term}]<Identifier, term> }

// The "#" that opens #(...). An external tokenizer (anon-tokens.ts) emits it
// only when the "#" is immediately followed by "(", so "#t"/"#f"/"#\c" and
// "#"-containing identifiers (e.g. ##report##) are unaffected. Declared
// before @tokens so it takes precedence over Identifier for a bare "#".
@external tokens anonHash from "../anon-tokens.js" { AnonHash }

@tokens {
  @precedence { Number, Boolean, Char, Identifier }

  Number {
    $[+\-]? (
      $[0-9]+ ("." $[0-9]*)? |
      "." $[0-9]+
    ) (("e" | "E") $[+\-]? $[0-9]+)?
  }

  // N.B., treats any run of characters not delimited by whitespace, brackets, a
  // string quote, an unescaped "'"/";", "." (number/rest disambiguation), or "&"
  // (the rest-parameter marker below) as an atom (disambiguated into
  // number/boolean/char/identifier afterward). This is deliberately permissive
  // so that identifiers like ">", "<=", "null?", and "set!" tokenize correctly.
  // The leading "%&" alternative lets the anonymous-function rest parameter
  // tokenize as a single identifier even though "&" is otherwise a delimiter.
  // It greedily consumes any trailing atom characters so that e.g. "%&x" is one
  // (invalid) identifier rather than "%&" followed by "x".
  //
  // An identifier may also be a one-level *qualified* name -- two base names
  // joined by a single "." (e.g. img.outlined-square) -- used to reference a
  // binding through an imported module's alias. Exactly one "." is allowed, so
  // there is no nested qualification (a.b.c does not tokenize as one name), and
  // a bare/trailing "." never joins the token. Whether a qualified name is legal
  // in a given position (a reference, never a binder) is decided in
  // lezer-bridge.ts, not here.
  baseIdentifier { "%&" ![ \t\n\r()\[\]{}'";.&]* | ![ \t\n\r()\[\]{}'";.&]+ }
  Identifier { baseIdentifier ("." baseIdentifier)? }

  // The "&" separating a lambda's fixed parameters from its rest parameter,
  // e.g. (lambda (x y & z) ...), or introducing a rest-only list, e.g.
  // (lambda (& z) ...). Clojure-style. Named (rather than an inline anonymous
  // literal) so it shows up in the parse tree and arglist can tell the rest
  // marker apart from an ordinary identifier.
  Amp { "&" }

  String { '"' (!["\\] | "\\" _)* '"' }

  Boolean { "#t" | "#f" }

  Char {
    "#\\" (
      // Named char (validated by runtime)
      $[a-zA-Z_\-0-9\+\*\=]+ |
      // Or any single non-whitespace, non-bracket character -- matches
      // reader.ts's tokenizer, which always stops a bare token at a
      // bracket, so e.g. "#\(" never reads as a valid char literal.
      ![ \t\n\r()\[\]{}]
    )
  }

  LineComment { ";" ![\n]* }

  space { $[ \t\n\r]+ }
}

@detectDelim
